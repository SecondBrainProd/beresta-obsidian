.","type":"TextQuoteSelector"}],"source":"urn:uuid:F5B4025F-94D6-5069-A9EB-9367A962329E","type":"SpecificResource"},"type":"Annotation"},{"beresta:chapterPath":["Введение"],"beresta:color":"yellow","beresta:colorHex":"#ffd54f","beresta:pageLabel":"17","beresta:processed":"raw","beresta:sortIndex":"00278#.000001#0000000000","beresta:type":"highlight","created":"2026-08-06T08:21:40Z","id":"urn:uuid:7F7659B1-EC38-502E-AA6B-56B7A1F0752F","modified":"2026-08-06T08:22:40Z","motivation":"highlighting","target":{"selector":[{"conformsTo":"http://www.idpf.org/epub/linking/cfi/epub-cfi.html","type":"FragmentSelector","value":"epubcfi(/6/14!/4,/2/1:0,/2/1:60)"},{"exact":"Внимание — единственная валюта, которой платят за понимание.","type":"TextQuoteSelector"}],"source":"urn:uuid:F5B4025F-94D6-5069-A9EB-9367A962329E","type":"SpecificResource"},"type":"Annotation"},{"beresta:chapterPath":["Часть I. Человек покупающий"],"beresta:color":"yellow","beresta:colorHex":"#ffd54f","beresta:processed":"raw","beresta:sortIndex":"00279#.000001#0000000000","beresta:type":"highlight","created":"2026-08-06T08:36:40Z","id":"urn:uuid:52E843AF-CA90-580B-A81C-43927FCD3EDD","modified":"2026-08-06T08:37:40Z","motivation":"highlighting","target":{"selector":[{"conformsTo":"http://www.idpf.org/epub/linking/cfi/epub-cfi.html","type":"FragmentSelector","value":"epubcfi(/6/16!/4,/2/1:0,/2/1:69)"},{"exact":"«Потом» — это имя, которое мы даём делу, чтобы не делать его сегодня.","type":"TextQuoteSelector"}],"source":"urn:uuid:F5B4025F-94D6-5069-A9EB-9367A962329E","type":"SpecificResource"},"type":"Annotation"},{"beresta:chapterPath":["Введение"],"beresta:color":"yellow","beresta:colorHex":"#ffd54f","beresta:processed":"raw","beresta:sortIndex":"00280#.000001#0000000000","beresta:type":"highlight","created":"2026-08-06T08:51:40Z","id":"urn:uuid:546EB637-C3A4-5B8A-9FE3-56E85913C142","modified":"2026-08-06T08:52:40Z","motivation":"highlighting","target":{"selector":[{"conformsTo":"http://www.idpf.org/epub/link