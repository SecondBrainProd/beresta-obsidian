{
  "compilerOptions": {
    // Куда доедет собранный `main.js`: настольный Obsidian — Electron,
    // мобильный — WebView. ES2018 покрывает оба и не тянет полифилов.
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2020"],

    // **Список `types` пуст нарочно, и это не украшение.** Пустой список
    // означает, что описаний Node в проверке типов нет вовсе: `require`,
    // `process`, `Buffer`, `fs` в `src/` перестают существовать как имена, и
    // попытка ими воспользоваться — ошибка проверки типов, а не молча
    // собравшийся плагин, который упадёт на мобильном Obsidian у человека.
    // Обещание «Node в рантайме нет» держится этой строкой, а не памятью.
    //
    // Тесты и сборщик живут по другому набору правил — `tsconfig.test.json`:
    // им Node нужен (читают файлы, зовут esbuild), и там он разрешён явно.
    "types": [],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Emit делает esbuild; `tsc` здесь только проверяет типы.
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
