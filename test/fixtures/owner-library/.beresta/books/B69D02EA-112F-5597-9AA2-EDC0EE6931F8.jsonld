7-9AA2-EDC0EE6931F8","type":"SpecificResource"},"type":"Annotation"},{"beresta:chapterPath":["Часть I. Человек покупающий"],"beresta:color":"blue","beresta:colorHex":"#4a90d9","beresta:pageLabel":"57","beresta:processed":"raw","beresta:sortIndex":"00201#.000001#0000000000","beresta:type":"highlight","created":"2026-08-06T18:21:40Z","id":"urn:uuid:5CDCA023-797C-567A-8970-D75B6D1531F7","modified":"2026-08-06T18:22:40Z","motivation":"highlighting","target":{"selector":[{"conformsTo":"http://www.idpf.org/epub/linking/cfi/epub-cfi.html","type":"FragmentSelector","value":"epubcfi(/6/94!/4,/2/1:0,/2/1:54)"},{"exact":"Ёмкость памяти не бесконечна, и в этом её достоинство.","type":"TextQuoteSelector"}],"source":"urn:uuid:B69D02EA-112F-5597-9AA2-EDC0EE6931F8","type":"SpecificResource"},"type":"Annotation"},{"beresta:chapterPath":["Введение"],"beresta:color":"blue","beresta:colorHex":"#4a90d9","beresta:processed":"raw","beresta:sortIndex":"00202#.000001#0000000000","beresta:topic":"внимание","beresta:type":"highlight","created":"2026-08-06T18:36:40Z","id":"urn:uuid:8F7E97E7-046A-58E1-AE91-1FBD5FE83145","modified":"2026-08-06T18:37:40Z","motivation":"highlighting","target":{"selector":[{"conformsTo":"http://www.idpf.org/epub/linking/cfi/epub-cfi.html","type":"FragmentSelector","value":"epubcfi(/6/96!/4,/2/1:0,/2/1:53)"},{"exact":"Смотри http://example.org/notes — там разбор целиком.","type":"TextQuoteSelector"}],"source":"urn:uuid:B69D02EA-112F-5597-9AA2-EDC0EE6931F8","type":"SpecificResource"},"type":"Annotation"}],"partOf":"urn:uuid:607E59DE-D38F-57CE-A2B5-D725DDE00C8B","startIndex":0,"type":"AnnotationPage"},"generated":"2026-08-06T18:37:40Z","id":"urn:uuid:607E59DE-D38F-57CE-A2B5-D725DDE00C8B","label":"Чёрный лебедь","last":"urn:uuid:51CDEA93-43B1-5E7E-977C-D53C37D280B3","total":47,"type":"AnnotationCollection"}